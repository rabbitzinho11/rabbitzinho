{
  "name": ".rabbit",
  "version": "1.3.2",
  "description": "Discord moderation bot with integrated web dashboard, Trust Score system and RSS integration (.rabbit)",
  "main": "src/index.js",
  "scripts": {
    "start": "NODE_ENV=production node src/index.js",
    "dev": "NODE_ENV=development node src/index.js",
    "test": "node tests/run-tests.js && node tests/unit/run-unit.js && node tests/integration/run-integration.js",
    "test:unit": "node tests/unit/run-unit.js",
    "test:integration": "node tests/integration/run-integration.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:audit": "node scripts/i18n-audit.js"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "moderation",
    "dashboard",
    "nodejs",
    "koyeb",
    "rss",
    "trust-score",
    "rabbit"
  ],
  "author": "mazeee1992",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maze92/rabbit-bot.git"
  },
  "bugs": {
    "url": "https://github.com/maze92/rabbit-bot/issues"
  },
  "homepage": "https://github.com/maze92/rabbit-bot#readme",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.1.2",
    "rss-parser": "^3.13.0",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
